-- ============================================================
-- JAL-RAKSHAK
-- NEON POSTGRESQL DATABASE SCHEMA
-- ============================================================


-- ============================================================
-- 1. DEVICES
-- ============================================================

CREATE TABLE IF NOT EXISTS devices (

    device_id VARCHAR(100) PRIMARY KEY,

    device_name VARCHAR(200) NOT NULL,

    latitude DOUBLE PRECISION,

    longitude DOUBLE PRECISION,

    location VARCHAR(300),

    status VARCHAR(50) DEFAULT 'OFFLINE',

    last_seen TIMESTAMPTZ,

    created_at TIMESTAMPTZ DEFAULT NOW()

);


-- ============================================================
-- 2. SENSOR READINGS
-- ============================================================

CREATE TABLE IF NOT EXISTS sensor_readings (

    reading_id BIGSERIAL PRIMARY KEY,

    device_id VARCHAR(100) NOT NULL,

    timestamp TIMESTAMPTZ DEFAULT NOW(),

    water_level DOUBLE PRECISION,

    rainfall DOUBLE PRECISION,

    temperature DOUBLE PRECISION,

    rise_rate DOUBLE PRECISION,

    acceleration DOUBLE PRECISION,

    water_trend VARCHAR(100),

    sensor_quality DOUBLE PRECISION,

    latitude DOUBLE PRECISION,

    longitude DOUBLE PRECISION,

    CONSTRAINT fk_sensor_device

        FOREIGN KEY (device_id)

        REFERENCES devices(device_id)

);


-- ============================================================
-- 3. EVENTS
-- ============================================================

CREATE TABLE IF NOT EXISTS events (

    event_id BIGSERIAL PRIMARY KEY,

    device_id VARCHAR(100) NOT NULL,

    event VARCHAR(100) NOT NULL,

    risk_score DOUBLE PRECISION,

    confidence DOUBLE PRECISION,

    timestamp TIMESTAMPTZ DEFAULT NOW(),

    latitude DOUBLE PRECISION,

    longitude DOUBLE PRECISION,

    status VARCHAR(50) DEFAULT 'ACTIVE',

    CONSTRAINT fk_event_device

        FOREIGN KEY (device_id)

        REFERENCES devices(device_id)

);


-- ============================================================
-- 4. ALERTS
-- ============================================================

CREATE TABLE IF NOT EXISTS alerts (

    alert_id BIGSERIAL PRIMARY KEY,

    device_id VARCHAR(100) NOT NULL,

    type VARCHAR(100),

    severity VARCHAR(50),

    message TEXT,

    sent_at TIMESTAMPTZ DEFAULT NOW(),

    status VARCHAR(50) DEFAULT 'PENDING',

    CONSTRAINT fk_alert_device

        FOREIGN KEY (device_id)

        REFERENCES devices(device_id)

);


-- ============================================================
-- 5. WEATHER
-- ============================================================

CREATE TABLE IF NOT EXISTS weather (

    weather_id BIGSERIAL PRIMARY KEY,

    device_id VARCHAR(100),

    rainfall_forecast DOUBLE PRECISION,

    temperature DOUBLE PRECISION,

    precipitation_probability DOUBLE PRECISION,

    timestamp TIMESTAMPTZ DEFAULT NOW(),

    CONSTRAINT fk_weather_device

        FOREIGN KEY (device_id)

        REFERENCES devices(device_id)

);


-- ============================================================
-- 6. AI/ML PREDICTIONS
-- ============================================================

CREATE TABLE IF NOT EXISTS predictions (

    prediction_id BIGSERIAL PRIMARY KEY,

    device_id VARCHAR(100) NOT NULL,

    predicted_event VARCHAR(100),

    risk_score DOUBLE PRECISION,

    confidence DOUBLE PRECISION,

    timestamp TIMESTAMPTZ DEFAULT NOW(),

    model_version VARCHAR(100),

    CONSTRAINT fk_prediction_device

        FOREIGN KEY (device_id)

        REFERENCES devices(device_id)

);


-- ============================================================
-- INDEXES
-- ============================================================

CREATE INDEX IF NOT EXISTS idx_sensor_device_time

ON sensor_readings(device_id, timestamp DESC);


CREATE INDEX IF NOT EXISTS idx_events_device_time

ON events(device_id, timestamp DESC);


CREATE INDEX IF NOT EXISTS idx_alerts_device_time

ON alerts(device_id, sent_at DESC);


CREATE INDEX IF NOT EXISTS idx_predictions_device_time

ON predictions(device_id, timestamp DESC);


CREATE INDEX IF NOT EXISTS idx_weather_device_time

ON weather(device_id, timestamp DESC);


-- ============================================================
-- COMPLETED
-- ============================================================

SELECT 'JAL-RAKSHAK database schema created successfully'
AS status;